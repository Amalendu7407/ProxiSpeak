# ProxiSpeak Server Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/proxispeak

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_at_least_32_chars_long
JWT_ISSUER=proxispeak-auth
JWT_AUDIENCE=proxispeak-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Domain Restriction for User Registration (e.g., infotact.com or company.com)
ALLOWED_EMAIL_DOMAIN=infotact.com

# Cloudinary v2 Profile Avatar Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WebRTC STUN/TURN Configuration
STUN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Spatial Audio & Proximity Parameters (Pixels)
PROXIMITY_AUDIO_RADIUS=250
PROXIMITY_CONNECTION_RADIUS=300
PROXIMITY_DISCONNECTION_RADIUS=360
